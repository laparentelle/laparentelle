---
import "../styles/global.css";
import Button from "../components/Button.astro";
import BookDialog from "../components/BookDialog.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "La Parent'elle — un lieu pluridisciplinaire pour la femme et la famille",
  description = "La Parent'elle, un lieu pluridisciplinaire pour la femme et la famille.",
  noindex = false,
} = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#2e5249" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=sentient@400,500,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=La+Belle+Aurore&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <p class="site-title"><a href="/">La Parent'elle</a></p>
        <nav class="site-nav" aria-label="Navigation principale">
          <a href="/">Accueil</a>
          <a href="/a-propos">À propos</a>
          <a href="/equipe">Notre équipe</a>
          <a href="/activites">Activités</a>
          <a href="/programme-du-mois">Planning</a>
          <a href="/contact">Contact</a>
          <Button small href="/contact">Nous rejoindre</Button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">La Parent'elle</p>
        <p>Un lieu pluridisciplinaire pour la femme et la famille.</p>
        <small>Mazan, au pied du Ventoux · Bien-être, Parentalité, Sport</small>
      </div>
    </footer>
    <BookDialog />
  </body>
</html>
