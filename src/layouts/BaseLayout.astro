---
import "../styles/fonts.css";
import "../styles/global.css";
import Button from "../components/Button.astro";
import BookDialog from "../components/BookDialog.astro";
import { getGlobalStory } from "../lib/storyblok";
import { resolveLink, imgSrc, lines } from "../lib/links";
import {
  absoluteUrl,
  breadcrumbSchema,
  cleanText,
  geoFrom,
  jsonLd,
  normalisePath,
  organizationSchema,
  parseManualSchema,
  robotsContent,
  siteOrigin,
  websiteSchema,
} from "../lib/seo";
import type { Crumb, SchemaNode, SiteInfo } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /** Route-level hard noindex (preview-only pages). Wins over `robots`. */
  noindex?: boolean;
  /** Editor-controlled robots option ("index,follow" | "noindex,follow" | …). */
  robots?: unknown;
  /** Page-level social image (absolute Storyblok URL). */
  image?: string;
  ogType?: "website" | "article";
  /** Editor-controlled canonical override (absolute or site-relative). */
  canonical?: string;
  /** Extra JSON-LD nodes appended to the site-wide @graph. */
  schema?: SchemaNode[];
  /** Breadcrumb trail (first item is usually the homepage). */
  breadcrumbs?: Crumb[];
}

const {
  title: pageTitle,
  description: pageDescription,
  noindex = false,
  robots: robotsOption,
  image: pageImage,
  ogType = "website",
  canonical: canonicalOverride,
  schema: extraSchema = [],
  breadcrumbs = [],
} = Astro.props;

// Site-wide settings (never throws: falls back when the story is missing).
const globalContent = ((await getGlobalStory())?.content ?? {}) as Record<string, any>;
const gtext = (v: unknown, fallback = "") =>
  typeof v === "string" && v.trim() ? v.trim() : fallback;
const isHex = (v: unknown): v is string =>
  typeof v === "string" && /^#[0-9a-fA-F]{6}$/.test(v.trim());

const origin = siteOrigin(Astro.url, Astro.site);
const path = normalisePath(Astro.url.pathname);

const siteName = gtext(globalContent.site_name, "La Parent'elle");
const rawTitle =
  pageTitle ??
  gtext(
    globalContent.seo_title,
    "La Parent'elle — un lieu pluridisciplinaire pour la femme et la famille",
  );
const description =
  pageDescription ??
  gtext(
    globalContent.seo_description,
    "La Parent'elle, un lieu pluridisciplinaire pour la femme et la famille.",
  );

// Qualify page titles with the site name, but never mangle a title that is
// already qualified ("Contact | La Parent'Elle" must stay untouched).
const flatten = (s: string) =>
  s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
const isQualified = (t: string) =>
  flatten(t).indexOf(flatten(siteName)) !== -1 ||
  /[|—–·]/.test(t) ||
  /\s-\s/.test(t);
const title =
  pageTitle && !isQualified(rawTitle) ? rawTitle + " — " + siteName : rawTitle;

const favicon = imgSrc(globalContent.favicon) || "/favicon.svg";
const logoSrc = imgSrc(globalContent.logo);
// iOS ignores SVG touch icons: only emit one when the logo is a raster image.
const appleTouchIcon = /\.png$/i.test(logoSrc)
  ? absoluteUrl(origin, logoSrc)
  : undefined;

// Share image: page override -> site default -> logo. No bare-origin
// fallback: an invalid og:image is worse than none.
const resolveImage = (v?: string) => {
  const s = (v || "").trim();
  return s ? absoluteUrl(origin, s) : undefined;
};
const ogImageSrc =
  resolveImage(pageImage) ||
  resolveImage(imgSrc(globalContent.og_image)) ||
  resolveImage(logoSrc);
const ogImage = globalContent.og_image;
const ogImageAlt =
  ogImage && typeof ogImage === "object" && cleanText(ogImage.alt)
    ? String(ogImage.alt)
    : siteName;

const themeColor = isHex(globalContent.theme_color)
  ? String(globalContent.theme_color).trim()
  : "#2e5249";

const atHandle = (v: unknown) => {
  const s = gtext(v).replace(/^@/, "");
  return s ? "@" + s : undefined;
};
const twitterSite = atHandle(globalContent.twitter_site);
const twitterCreator = atHandle(globalContent.twitter_creator);

const robots = robotsContent(robotsOption, noindex);
// Draft content must never be indexed: the preview deployment and the local
// dev server always answer noindex, whatever the editor chose.
const previewEnv = import.meta.env.DEV || import.meta.env.IS_PREVIEW === "true";
const robotsFinal = previewEnv ? "noindex, nofollow" : robots;
const canonical = canonicalOverride
  ? absoluteUrl(origin, canonicalOverride.trim())
  : absoluteUrl(origin, path);

const geo = geoFrom(globalContent.geo_latitude, globalContent.geo_longitude);
const site: SiteInfo = {
  origin: origin,
  siteName: siteName,
  locale: "fr_FR",
  logo: logoSrc ? absoluteUrl(origin, logoSrc) : undefined,
  ogImage: ogImageSrc,
  address: gtext(globalContent.footer_address) || undefined,
  phone: gtext(globalContent.footer_phone) || undefined,
  email: gtext(globalContent.footer_email) || undefined,
  tagline: gtext(globalContent.footer_tagline) || undefined,
  sameAs: lines(globalContent.same_as).filter((u) => /^https?:\/\//i.test(u)),
  geoLat: geo ? geo.lat : undefined,
  geoLon: geo ? geo.lon : undefined,
};

const graph: SchemaNode[] = [
  organizationSchema(site),
  websiteSchema(site),
].concat(extraSchema, parseManualSchema(globalContent.schema_manual));
const crumbs = breadcrumbSchema(origin, breadcrumbs);
if (crumbs) graph.push(crumbs);

const menuItems = (
  Array.isArray(globalContent.menu_items) && globalContent.menu_items.length
    ? globalContent.menu_items.filter(
        (b: any) => b?.component === "menu_item" && b.label,
      )
    : [
        { label: "Accueil", link: { cached_url: "home" } },
        { label: "À propos", link: { cached_url: "a-propos" } },
        { label: "Notre équipe", link: { cached_url: "equipe" } },
        { label: "Activités", link: { cached_url: "activites" } },
        { label: "Planning", link: { cached_url: "programme-du-mois" } },
        { label: "Contact", link: { cached_url: "contact" } },
      ]
).map((b: any) => ({ label: b.label as string, href: resolveLink(b.link) }));
const ctaLabel = gtext(globalContent.cta_label);
const ctaHref = resolveLink(globalContent.cta_link);

const footer = {
  brand: gtext(globalContent.footer_brand, "La Parent'elle"),
  tagline: gtext(
    globalContent.footer_tagline,
    "Un lieu pluridisciplinaire pour la femme et la famille.",
  ),
  address: gtext(globalContent.footer_address),
  phone: gtext(globalContent.footer_phone),
  email: gtext(globalContent.footer_email),
  note: gtext(
    globalContent.footer_note,
    "Mazan, au pied du Ventoux · Bien-être, Parentalité, Sport",
  ),
};

const colorVars = (
  [
    ["--c-pine", globalContent.color_primary],
    ["--c-marigold", globalContent.color_accent],
    ["--c-cream", globalContent.color_background],
  ] as [string, unknown][]
)
  .filter(([, v]) => isHex(v))
  .map(([k, v]) => `${k}:${(v as string).trim()}`)
  .join(";");
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsFinal} />
    <meta name="googlebot" content={robotsFinal} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph — Facebook, WhatsApp, LinkedIn, Discord, iMessage… */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageSrc && <meta property="og:image" content={ogImageSrc} />}
    {ogImageSrc && <meta property="og:image:alt" content={ogImageAlt} />}

    {/* X / Twitter */}
    <meta
      name="twitter:card"
      content={ogImageSrc ? "summary_large_image" : "summary"}
    />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageSrc && <meta name="twitter:image" content={ogImageSrc} />}
    {ogImageSrc && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
    {colorVars && <style set:html={`:root{${colorVars}}`} />}
    {/* Fonts are self-hosted (see styles/fonts.css): no third-party font
        origin left. Preconnect to the image CDN serving the eager hero. */}
    <link rel="preconnect" href="https://a.storyblok.com" />
    <script
      type="application/ld+json"
      set:html={jsonLd({ "@context": "https://schema.org", "@graph": graph })}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <p class="site-title">
          <a href="/" aria-label={siteName}>
            {logoSrc ? (
              <img src={logoSrc} alt={siteName} class="site-logo" />
            ) : (
              siteName
            )}
          </a>
        </p>
        <nav class="site-nav" aria-label="Navigation principale">
          <button
            type="button"
            class="nav-toggle"
            aria-expanded="false"
            aria-controls="nav-links"
            aria-label="Ouvrir le menu"
          >
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path
                d="M2.5 5h15M2.5 10h15M2.5 15h15"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
              />
            </svg>
          </button>
          <div class="nav-links" id="nav-links">
            {menuItems.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
            {ctaLabel && <Button small href={ctaHref}>{ctaLabel}</Button>}
          </div>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">{footer.brand}</p>
        {footer.tagline && <p>{footer.tagline}</p>}
        {(footer.address || footer.phone || footer.email) && (
          <p>
            {[footer.address, footer.phone, footer.email]
              .filter(Boolean)
              .join(" · ")}
          </p>
        )}
        {footer.note && <small>{footer.note}</small>}
      </div>
    </footer>
    <BookDialog />
    <script>
      // Overflow-aware nav: the hamburger appears whenever the links no
      // longer fit, whatever the link count or viewport width.
      document.documentElement.classList.add("js");
      const nav = document.querySelector(".site-nav");
      const links = nav?.querySelector(".nav-links");
      const toggle = nav?.querySelector(".nav-toggle");
      if (nav && links && toggle) {
        const setOpen = (open: boolean) => {
          nav.classList.toggle("is-open", open);
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? "Fermer le menu" : "Ouvrir le menu");
        };
        const update = () => {
          // Measure in the expanded state, then collapse if overflowing.
          // Uses layout boxes (not scrollWidth: the CTA button's 3D hover
          // face pollutes the scroll overflow area).
          nav.classList.remove("is-collapsed");
          const linksBox = links.getBoundingClientRect();
          const last = links.lastElementChild;
          const overflows =
            !!last && last.getBoundingClientRect().right > linksBox.right + 1;
          nav.classList.toggle("is-collapsed", overflows);
          if (!overflows) setOpen(false);
        };
        toggle.addEventListener("click", () => {
          setOpen(!nav.classList.contains("is-open"));
        });
        links.addEventListener("click", (event) => {
          if ((event.target as HTMLElement).closest("a")) setOpen(false);
        });
        document.addEventListener("click", (event) => {
          if (!nav.contains(event.target as Node)) setOpen(false);
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            setOpen(false);
            (toggle as HTMLButtonElement).blur();
          }
        });
        let resizeTimer: number | undefined;
        window.addEventListener("resize", () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(update, 120);
        });
        if (document.fonts?.ready) document.fonts.ready.then(update);
        window.addEventListener("load", update);
        update();
      }
    </script>
  </body>
</html>
