---
import BaseLayout from "../layouts/BaseLayout.astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import Person from "../components/storyblok/Person.astro";
import ActivityPage from "../components/storyblok/ActivityPage.astro";
import GlobalDoc from "../components/storyblok/GlobalDoc.astro";
import { getPageStory } from "../lib/storyblok";
import { normalisePath, seoPropsFrom } from "../lib/seo";
import type { Crumb } from "../lib/seo";

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) return Astro.redirect("/");
let story: any = null;
try {
  story = await getPageStory(slug);
} catch {
  story = null;
}
if (!story) return new Response(null, { status: 404 });

const content = story.content;
// The `global` settings story is preview-only documentation: it must never
// render as a public page.
const isGlobalDoc = content.component === "global";
const isPreviewEnv =
  import.meta.env.DEV || import.meta.env.IS_PREVIEW === "true";
if (isGlobalDoc && !isPreviewEnv) return new Response(null, { status: 404 });
// Session stories live under seances/ and are only rendered through the
// planning / activity pages — never as standalone pages.
if ((slug ?? "").startsWith("seances/") || content.component === "session") {
  return new Response(null, { status: 404 });
}
// A person can exist without a public page (page_enabled === false).
if (content.component === "person" && content.page_enabled === false) {
  return new Response(null, { status: 404 });
}
// Story tags (used for filtering) live on the story, not in content:
// pass them explicitly to the person template.
const title = content.seo_title ?? content.name ?? story.name;
// Editor-controlled SEO fields (robots, share image, canonical, schema).
const seo = seoPropsFrom(content);

// Breadcrumbs help search engines show a richer result path. The trail
// always ends on the current page (no trailing slash, like the canonical).
const currentUrl = normalisePath("/" + slug);
const pageName = content.seo_title ?? content.name ?? story.name;
const trail: Crumb[] = [{ name: "Accueil", href: "/" }];
if (content.component === "person" && (slug ?? "").startsWith("equipe/")) {
  trail.push({ name: "Notre équipe", href: "/equipe" });
} else if (
  content.component === "activity_page" &&
  (slug ?? "").startsWith("activites/")
) {
  trail.push({ name: "Activités", href: "/activites" });
}
if (slug !== "equipe" && slug !== "activites") {
  trail.push({ name: pageName, href: currentUrl });
}
---

<BaseLayout
  title={title}
  description={content.seo_description}
  noindex={isGlobalDoc}
  robots={seo.robots}
  image={seo.image}
  ogType={seo.ogType}
  canonical={seo.canonical}
  schema={seo.schema}
  breadcrumbs={trail}
>
  {isGlobalDoc ? (
    <GlobalDoc story={story} />
  ) : content.component === "person" ? (
    <Person blok={content} tags={story.tag_list ?? []} pageUrl={currentUrl} />
  ) : content.component === "activity_page" ? (
    <ActivityPage blok={content} tags={story.tag_list ?? []} activityUuid={story.uuid} />
  ) : (
    <StoryblokComponent blok={content} />
  )}
</BaseLayout>
