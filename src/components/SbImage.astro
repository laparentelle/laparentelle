---
/**
 * Responsive image for CMS content.
 *
 * - Remote Storyblok URLs go through Astro's <Image> pipeline: resized
 *   WebP variants (build time in production, Vercel Image Optimization
 *   in preview), with width/height inferred for layout stability.
 * - Imported local assets (ImageMetadata) get the same treatment.
 * - Plain site-relative paths (public/) render as a classic <img>.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string | ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  src,
  alt,
  widths = [480, 800, 1200],
  sizes = "100vw",
  loading = "lazy",
  fetchpriority,
  class: cls,
} = Astro.props;

const isRemote = typeof src === "string" && src.indexOf("http") === 0;
---

{
  isRemote ? (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      class={cls}
      inferSize
    />
  ) : typeof src === "string" ? (
    <img
      src={src}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      class={cls}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      class={cls}
    />
  )
}
