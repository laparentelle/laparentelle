---
import { storyblokEditable, renderRichText } from "@storyblok/astro";
import { imgSrc, imgAlt } from "../../lib/links";
import Button from "../Button.astro";
import SbImage from "../SbImage.astro";
import {
  fetchSessionsByActivity,
  fetchPractitioners,
  sessionTiming,
} from "../../lib/sessions";
import { parseSessionDate } from "../../lib/date";
import { getGlobalStory } from "../../lib/storyblok";
import { countBookingsBulk, isBookingsConfigured } from "../../lib/bookings";
import {
  absoluteUrl,
  eventSchema,
  jsonLd,
  siteInfoFromGlobal,
  siteOrigin,
} from "../../lib/seo";

interface Props {
  blok: {
    title?: string;
    image?: string | { filename?: string; alt?: string };
    animator?: string;
    schedule?: string;
    price?: string;
    email?: string;
    phone?: string;
    booking_label?: string;
    booking_link?: any;
    description?: any;
  };
  tags?: string[];
  /** UUID of the `activity_page` story: used to find linked sessions. */
  activityUuid?: string;
}

const { blok, tags = [], activityUuid = "" } = Astro.props;
const description = blok.description ? renderRichText(blok.description) : "";
const src = imgSrc(blok.image);
const bookingHref =
  blok.booking_link?.cached_url || blok.booking_link?.url
    ? (blok.booking_link.url ?? `/${blok.booking_link.cached_url}`)
    : null;

// Upcoming planning sessions linked to this activity page.
const bookingsOn = isBookingsConfigured();
const upcoming = await fetchSessionsByActivity(activityUuid);
const peopleByUuid = new Map<string, string>();
try {
  const uuids = upcoming.flatMap((s) => s.people ?? []);
  for (const [uuid, p] of await fetchPractitioners(uuids)) {
    peopleByUuid.set(uuid, p.name);
  }
} catch {
  /* practitioner names are a nice-to-have here */
}
let upcomingCounts: Record<string, number> = {};
if (bookingsOn && upcoming.length) {
  try {
    upcomingCounts = await countBookingsBulk(upcoming.map((s) => s.uid));
  } catch {
    upcomingCounts = {};
  }
}
const upcomingLeft = (uid: string, capacity?: number) => {
  if (!bookingsOn || !capacity) return null;
  return Math.max(0, capacity - (upcomingCounts[uid] ?? 0));
};

// Event schema for the listed slots (JSON-LD is valid in the body).
const origin = siteOrigin(Astro.url, Astro.site);
const site = siteInfoFromGlobal(
  origin,
  (await getGlobalStory())?.content,
  "La Parent'elle",
);
const dayKeyOf = (d: Date) => d.toLocaleDateString("en-CA");
const eventNodes = upcoming.slice(0, 12).flatMap((s) => {
  const start = parseSessionDate(s.start);
  if (!start) return [];
  const names = (s.people ?? [])
    .map((uuid) => peopleByUuid.get(uuid))
    .filter((n): n is string => Boolean(n));
  return [
    eventSchema(site, {
      title: s.title || String(blok.title || ""),
      start: start,
      minutes: typeof s.duration === "number" && s.duration > 0 ? s.duration : 60,
      url: absoluteUrl(origin, "/programme-du-mois?date=" + dayKeyOf(start)),
      description:
        typeof s.note === "string" && s.note.trim() ? s.note.trim() : undefined,
      capacity: !s.external_booking && s.capacity ? s.capacity : undefined,
      performers: names.map((name) => ({ name: name })),
    }),
  ];
});
---

<article class="activity-page" {...storyblokEditable(blok)}>
  <header class="activity-head">
    <div>
      {blok.title && <h1 class="activity-title">{blok.title}</h1>}
      {blok.animator && <p class="activity-animator">Avec {blok.animator}</p>}
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) => <li class="badge">{t}</li>)}
        </ul>
      )}
    </div>
    {src && (
      <figure class="activity-photo">
        <SbImage
          src={src}
          alt={imgAlt(blok.photo, blok.title)}
          widths={[480, 800, 1200]}
          sizes="(max-width: 700px) 100vw, 640px"
          loading="eager"
        />
      </figure>
    )}
  </header>

  {description && (
    <section class="activity-block">
      <div class="richtext" set:html={description} />
    </section>
  )}

  {(blok.schedule || blok.price) && (
    <section class="activity-block info-card">
      <h2>Jours & tarifs</h2>
      {blok.schedule && <p class="pre">{blok.schedule}</p>}
      {blok.price && <p class="pre">{blok.price}</p>}
    </section>
  )}

  {upcoming.length > 0 && (
    <section class="activity-block">
      <h2>Prochains créneaux</h2>
      <ul class="slot-list">
        {upcoming.slice(0, 6).map((s) => {
          const timing = sessionTiming(s.start, s.duration ?? 60);
          const left = upcomingLeft(s.uid, s.capacity);
          const names = (s.people ?? [])
            .map((uuid) => peopleByUuid.get(uuid))
            .filter(Boolean)
            .join(", ");
          return (
            <li class="slot-row">
              <div>
                <strong>{timing.date}</strong>
                {timing.range && <span> · {timing.range}</span>}
                {names && <span class="slot-who"> — {names}</span>}
                {left !== null && (
                  <span class="slot-spots">
                    {" "}· {left === 0 ? "complet" : `${left} place${left > 1 ? "s" : ""}`}
                  </span>
                )}
              </div>
              <a class="slot-link" href="/programme-du-mois">Réserver</a>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <aside class="activity-contact">
    <h2>Participer</h2>
    <div class="btn-row">
      {blok.booking_label && bookingHref && (
        <Button href={bookingHref}>{blok.booking_label}</Button>
      )}
      {blok.phone && (
        <Button variant="ghost" href={`tel:${blok.phone.replace(/[\s.]/g, "")}`}>
          {blok.phone}
        </Button>
      )}
      {blok.email && (
        <Button variant="ghost" href={`mailto:${blok.email}`}>
          {blok.email}
        </Button>
      )}
      {(!bookingHref || !blok.booking_label) && (
        <Button variant="ghost" href="/contact">Nous contacter</Button>
      )}
    </div>
  </aside>

  <p class="back">
    <a href="/activites">← Toutes les activités</a>
  </p>
  {eventNodes.length > 0 && (
    <script
      type="application/ld+json"
      set:html={jsonLd({ "@context": "https://schema.org", "@graph": eventNodes })}
    />
  )}
</article>

<style>
  .activity-page {
    padding-block: 3rem 4rem;
    display: grid;
    gap: 2.5rem;
  }

  .activity-head {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .activity-head {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2.5rem;
    }
  }

  .activity-title {
    margin: 0 0 0.25rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
  }

  .activity-animator {
    margin: 0 0 1rem;
    color: var(--c-pine-soft);
    font-size: 1.1rem;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .activity-photo {
    margin: 0;
  }

  .activity-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
    display: block;
  }

  .activity-block .richtext {
    color: var(--muted);
    max-width: 46rem;
  }

  .activity-block h2 {
    font-size: 1.4rem;
    margin: 0 0 0.75rem;
  }

  .info-card {
    border: 0;
    border-radius: var(--radius-card);
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu);
    padding: 1.75rem;
    max-width: 46rem;
  }

  .pre {
    white-space: pre-line;
    margin: 0 0 0.75rem;
    color: var(--muted);
  }

  .pre:last-child {
    margin-bottom: 0;
  }

  .slot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 46rem;
  }

  .slot-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    border: 1px solid var(--c-line);
    border-radius: 0.75rem;
    background: #fff;
  }

  .slot-who,
  .slot-spots {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .slot-link {
    color: var(--c-pine);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .slot-link:hover {
    text-decoration: underline;
  }

  .activity-contact {
    border: 0;
    border-radius: var(--radius-card);
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu);
    padding: 1.75rem;
  }

  .activity-contact h2 {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
  }

  .back a {
    color: var(--c-pine);
    text-decoration: none;
  }
</style>
