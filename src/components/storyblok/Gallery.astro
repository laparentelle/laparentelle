---
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

interface Props {
  blok: {
    eyebrow?: string;
    title?: string;
    items?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="gallery-blok blok-section" {...storyblokEditable(blok)}>
  {blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
  {blok.title && <h2 class="section-title">{blok.title}</h2>}
  <div class="gallery-grid">
    {(blok.items ?? []).map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
</section>

<style>
  .gallery-grid {
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }
</style>
