---
import { storyblokEditable } from "@storyblok/astro";
import { resolveLink, imgSrc, imgAlt } from "../../lib/links";
import SbImage from "../SbImage.astro";
import Button from "../Button.astro";

interface Props {
  blok: {
    eyebrow?: string;
    title?: string;
    image?: string | { filename?: string; alt?: string };
    text?: string;
    cta_label?: string;
    cta_link?: any;
  };
}

const { blok } = Astro.props;
const src = imgSrc(blok.image);
---

<section class="spotlight-blok blok-section" {...storyblokEditable(blok)}>
  <div class="spotlight-card">
    {src && (
      <figure class="spotlight-media frame-organic">
        <SbImage
          src={src}
          alt={imgAlt(blok.image)}
          widths={[480, 800, 1200]}
          sizes="(max-width: 700px) 100vw, 600px"
          loading="lazy"
        />
      </figure>
    )}
    <div class="spotlight-copy">
      {blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
      {blok.title && <h2 class="section-title">{blok.title}</h2>}
      {blok.text && <p class="section-intro">{blok.text}</p>}
      {blok.cta_label && (
        <div class="btn-row">
          <Button href={resolveLink(blok.cta_link)}>{blok.cta_label}</Button>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .spotlight-card {
    border: 0;
    border-radius: var(--radius-card);
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu);
    overflow: hidden;
    display: grid;
  }

  @media (min-width: 48rem) {
    .spotlight-card {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  .spotlight-media {
    margin: 0;
    min-height: 100%;
  }

  .spotlight-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .spotlight-copy {
    padding: 2rem;
  }
</style>
