---
import { storyblokEditable } from "@storyblok/astro";
import { resolveLink, imgSrc, imgAlt } from "../../lib/links";

interface Props {
  blok: {
    image?: string | { filename?: string; alt?: string };
    title?: string;
    subtitle?: string;
    text?: string;
    link?: any;
  };
}

const { blok } = Astro.props;
const src = imgSrc(blok.image);
---

<article class="card" {...storyblokEditable(blok)}>
  {src && (
    <img class="card-img" src={src} alt={imgAlt(blok.image, blok.title)} loading="lazy" />
  )}
  <div class="card-body">
    {blok.title && <h3 class="card-title">{blok.title}</h3>}
    {blok.subtitle && <p class="card-subtitle">{blok.subtitle}</p>}
    {blok.text && <p class="card-text">{blok.text}</p>}
    {blok.link && (blok.link.cached_url || blok.link.url) && (
      <a class="card-link" href={resolveLink(blok.link)}>Découvrir →</a>
    )}
  </div>
</article>

<style>
  .card {
    border: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-neu-lg);
  }

  .card-img {
    width: 100%;
    aspect-ratio: 3 / 1;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
  }

  .card-subtitle {
    margin: 0;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    color: var(--accent);
  }

  .card-text {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .card-link {
    margin-top: 0.5rem;
    text-decoration: none;
    font-weight: bold;
  }
</style>
