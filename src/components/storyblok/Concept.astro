---
import { storyblokEditable, renderRichText } from "@storyblok/astro";
import { lines } from "../../lib/links";

interface Props {
  blok: {
    eyebrow?: string;
    title?: string;
    text?: any;
    tags?: string;
  };
}

const { blok } = Astro.props;
const html = blok.text ? renderRichText(blok.text) : "";
const tags = lines(blok.tags);
---

<section class="concept-blok blok-section" {...storyblokEditable(blok)}>
  {blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
  {blok.title && <h2 class="section-title">{blok.title}</h2>}
  {html && <div class="richtext section-intro" set:html={html} />}
  {tags.length > 0 && (
    <ul class="tags">
      {tags.map((t) => <li>{t}</li>)}
    </ul>
  )}
</section>

<style>
  .tags {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tags li {
    border: 0;
    border-radius: 999px;
    padding: 0.4rem 1.05rem;
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu-sm);
    font-size: 0.9rem;
  }
</style>
