---
import { storyblokEditable, renderRichText } from "@storyblok/astro";
import { resolveLink, imgSrc, imgAlt } from "../../lib/links";
import SbImage from "../SbImage.astro";
import heroFallback from "../../assets/hero.webp";
import Button from "../Button.astro";

interface Props {
  blok: {
    eyebrow?: string;
    title?: string;
    text?: any;
    primary_label?: string;
    primary_link?: any;
    secondary_label?: string;
    secondary_link?: any;
    image?: string | { filename?: string; alt?: string };
  };
}

const { blok } = Astro.props;
const html = blok.text ? renderRichText(blok.text) : "";
// Local default visual; a Storyblok image overrides it when set.
const src = imgSrc(blok.image) || heroFallback;
---

<section class="hero-blok" {...storyblokEditable(blok)}>
  <div class="hero-bg" aria-hidden="true">
    <SbImage
      src={src}
      alt=""
      widths={[800, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content">
    {blok.eyebrow && <p class="eyebrow eyebrow-light">{blok.eyebrow}</p>}
    {blok.title && <h1 class="hero-title">{blok.title}</h1>}
    {html && <div class="richtext hero-text" set:html={html} />}
    <div class="btn-row">
      {blok.primary_label && (
        <Button variant="contrast" href={resolveLink(blok.primary_link)}>{blok.primary_label}</Button>
      )}
      {blok.secondary_label && (
        <Button variant="outline-light" href={resolveLink(blok.secondary_link)}>{blok.secondary_label}</Button>
      )}
    </div>
  </div>
  <span class="sr-only">{imgAlt(blok.image)}</span>
</section>

<script>
  import { initHeroParallax } from "../../lib/animations";
  initHeroParallax();
</script>

<style>
  .hero-blok {
    position: relative;
    min-height: calc(100svh - 4rem);
    display: flex;
    align-items: flex-end;
    overflow: clip;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: -10% 0;
    z-index: -2;
    will-change: transform;
  }

  .hero-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        rgb(32 59 52 / 0.82) 0%,
        rgb(32 59 52 / 0.35) 45%,
        rgb(32 59 52 / 0.15) 100%
      );
  }

  .hero-content {
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(4rem, 10vh, 7rem) 1.5rem;
    color: #fff;
  }

  .eyebrow-light {
    color: var(--c-sage);
  }

  .hero-title {
    margin: 0 0 1rem;
    max-width: 16ch;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.02;
  }

  .hero-text {
    max-width: 38rem;
    color: #f2ede1;
    font-size: 1.1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
