---
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

interface Props {
  blok: {
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="faq-blok blok-section" {...storyblokEditable(blok)}>
  {blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
  {blok.title && <h2 class="section-title">{blok.title}</h2>}
  {blok.intro && <p class="section-intro">{blok.intro}</p>}
  <div class="faq-list">
    {(blok.items ?? []).map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
</section>

<style>
  .faq-list {
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
  }
</style>
