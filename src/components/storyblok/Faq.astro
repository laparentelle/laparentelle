---
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import { faqPageSchema, jsonLd, richtextToText, squashWhitespace } from "../../lib/seo";

interface Props {
  blok: {
    eyebrow?: string;
    title?: string;
    intro?: string;
    items?: any[];
  };
}

const { blok } = Astro.props;

// FAQPage schema, generated from the visible questions. Answers are
// richtext: strip the markup, schema text must be plain.
const faqNode = faqPageSchema(
  (blok.items ?? []).map((item) => ({
    question: typeof item?.question === "string" ? item.question : "",
    answer: squashWhitespace(richtextToText(item?.answer)),
  })),
);
---

<section class="faq-blok blok-section" {...storyblokEditable(blok)}>
  {blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
  {blok.title && <h2 class="section-title">{blok.title}</h2>}
  {blok.intro && <p class="section-intro">{blok.intro}</p>}
  <div class="faq-list">
    {(blok.items ?? []).map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
  {faqNode && (
    <script
      type="application/ld+json"
      set:html={jsonLd({ "@context": "https://schema.org", ...faqNode })}
    />
  )}
</section>

<style>
  .faq-list {
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
  }
</style>
