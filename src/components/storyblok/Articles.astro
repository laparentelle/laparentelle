---
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import { resolveLink } from "../../lib/links";
import Button from "../Button.astro";

interface Props {
  blok: {
    eyebrow?: string;
    title?: string;
    all_label?: string;
    all_link?: any;
    items?: any[];
  };
}

const { blok } = Astro.props;
---

<section class="articles-blok blok-section" {...storyblokEditable(blok)}>
  {blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
  {blok.title && <h2 class="section-title">{blok.title}</h2>}
  <div class="articles-grid">
    {(blok.items ?? []).map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
  {blok.all_label && (
    <div class="btn-row">
      <Button variant="ghost" href={resolveLink(blok.all_link)}>{blok.all_label}</Button>
    </div>
  )}
</section>

<style>
  .articles-grid {
    margin-top: 2rem;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }
</style>
