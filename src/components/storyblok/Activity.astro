---
import { storyblokEditable } from "@storyblok/astro";
import { imgSrc, imgAlt } from "../../lib/links";
import Button from "../Button.astro";
import {
  fetchSession,
  fetchPractitioners,
  sessionTiming,
  sessionDayKey,
  formatDuration,
} from "../../lib/sessions";
import { countBookingsBulk, isBookingsConfigured } from "../../lib/bookings";

interface Props {
  blok: {
    /** Linked `session` story UUID: populates the card; hidden when unset or past. */
    session?: string;
    image?: string | { filename?: string; alt?: string };
    price?: string;
    booking_label?: string;
  };
}

const TYPE_LABEL: Record<string, string> = {
  activite: "Activité",
  sport: "Sport",
  bienetre: "Bien-être",
  consultation: "Consultation",
};

const { blok } = Astro.props;
const src = imgSrc(blok.image);
const bookingsOn = isBookingsConfigured();

// The linked session, when still upcoming — otherwise the card is hidden.
const sessionUuid = typeof blok.session === "string" && blok.session ? blok.session : "";
let session = sessionUuid ? await fetchSession(sessionUuid).catch(() => null) : null;
if (session?.start) {
  const d = new Date(session.start);
  if (Number.isNaN(d.getTime()) || d < new Date()) session = null;
}

// Availability of the session (external sessions bypass the planning counts).
let left: number | null = null;
if (session && bookingsOn && !session.external_booking && session.capacity) {
  try {
    const counts = await countBookingsBulk([session.uid]);
    left = Math.max(0, session.capacity - (counts[session.uid] ?? 0));
  } catch {
    left = null;
  }
}
const full = session ? !session.external_booking && left === 0 : false;

// Practitioner names of the session.
let practitionerNames = "";
if (session) {
  try {
    const map = await fetchPractitioners(session.people ?? []);
    practitionerNames = (session.people ?? [])
      .map((uuid) => map.get(uuid)?.name)
      .filter(Boolean)
      .join(", ");
  } catch {
    /* practitioner names are a nice-to-have here */
  }
}

const timing = session ? sessionTiming(session.start, session.duration ?? 60) : undefined;
const planningHref =
  session && session.start ? `/programme-du-mois?date=${sessionDayKey(session.start) ?? ""}` : "/programme-du-mois";
---

{
  session && (
    <article class="activity" {...storyblokEditable(blok)}>
      {src && <img class="activity-img" src={src} alt={imgAlt(blok.image, session.title)} loading="lazy" />}
      <div class="activity-body">
        {(TYPE_LABEL[session.type ?? ""] ?? session.type) && (
          <p class="eyebrow">{TYPE_LABEL[session.type ?? ""] ?? session.type}</p>
        )}
        <h3 class="activity-title">{session.title}</h3>
        <p class="activity-meta">
          {[formatDuration(session.duration ?? 60), practitionerNames].filter(Boolean).join(" · ")}
        </p>
        {timing?.date && (
          <p class="activity-next">
            Prochain créneau : {timing.date}
            {timing.range && ` · ${timing.range}`}
          </p>
        )}
        {blok.price && <p class="activity-price">{blok.price}</p>}
        {bookingsOn && full ? (
          <span class="activity-full">Complet</span>
        ) : (
          <Button small variant="contrast" href={planningHref}>
            {blok.booking_label || "Réserver"}
          </Button>
        )}
      </div>
    </article>
  )
}

<style>
  .activity {
    border: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu);
    display: flex;
    flex-direction: column;
  }

  .activity-img {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    display: block;
  }

  .activity-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    align-items: flex-start;
  }

  .activity-title {
    margin: 0;
    font-size: 1.15rem;
  }

  .activity-meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .activity-next {
    margin: 0;
    color: var(--c-pine);
    font-size: 0.85rem;
  }

  .activity-price {
    margin: 0;
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--accent);
  }

  .activity-full {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .activity-body :global(.button-027) {
    margin-top: 0.5rem;
  }
</style>
