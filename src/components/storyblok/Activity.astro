---
import { storyblokEditable } from "@storyblok/astro";
import { resolveLink, imgSrc, imgAlt } from "../../lib/links";
import Button from "../Button.astro";

interface Props {
  blok: {
    image?: string | { filename?: string; alt?: string };
    category?: string;
    title?: string;
    duration?: string;
    practitioner?: string;
    price?: string;
    member_price?: string;
    booking_label?: string;
    booking_link?: any;
  };
}

const { blok } = Astro.props;
const src = imgSrc(blok.image);
---

<article class="activity" {...storyblokEditable(blok)}>
  {src && (
    <img class="activity-img" src={src} alt={imgAlt(blok.image, blok.title)} loading="lazy" />
  )}
  <div class="activity-body">
    {blok.category && <p class="eyebrow">{blok.category}</p>}
    {blok.title && <h3 class="activity-title">{blok.title}</h3>}
    {(blok.duration || blok.practitioner) && (
      <p class="activity-meta">
        {[blok.duration, blok.practitioner].filter(Boolean).join(" · ")}
      </p>
    )}
    {(blok.price || blok.member_price) && (
      <p class="activity-prices">
        {blok.price && <span class="price-full">{blok.price}</span>}
        {blok.member_price && <span class="price-member">{blok.member_price}</span>}
      </p>
    )}
    {blok.booking_label && (
      <Button small variant="contrast" href={resolveLink(blok.booking_link)}>{blok.booking_label}</Button>
    )}
  </div>
</article>

<style>
  .activity {
    border: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu);
    display: flex;
    flex-direction: column;
  }

  .activity-img {
    width: 100%;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    display: block;
  }

  .activity-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    align-items: flex-start;
  }

  .activity-title {
    margin: 0;
    font-size: 1.15rem;
  }

  .activity-meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .activity-prices {
    margin: 0;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .price-full {
    text-decoration: line-through;
    color: var(--muted);
  }

  .price-member {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--accent);
  }
</style>
