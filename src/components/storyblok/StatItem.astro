---
import { storyblokEditable } from "@storyblok/astro";

interface Props {
  blok: {
    value?: string;
    label?: string;
  };
}

const { blok } = Astro.props;
---

<div class="stat" {...storyblokEditable(blok)}>
  {blok.value && <p class="stat-value">{blok.value}</p>}
  {blok.label && <p class="stat-label">{blok.label}</p>}
</div>

<style>
  .stat {
    text-align: center;
  }

  .stat-value {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    line-height: 1;
  }

  .stat-label {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
