---
import { storyblokEditable, renderRichText } from "@storyblok/astro";
import { imgSrc, imgAlt, resolveLink } from "../../lib/links";
import { adminEmail } from "../../lib/contacts";
import { getGlobalStory } from "../../lib/storyblok";
import {
  absoluteUrl,
  jsonLd,
  personSchema,
  siteInfoFromGlobal,
  siteOrigin,
} from "../../lib/seo";
import Button from "../Button.astro";
import ContactForm from "../ContactForm.astro";
import SbImage from "../SbImage.astro";
import {
  fetchSessionsByPerson,
  sessionDayKey,
  sessionTiming,
} from "../../lib/sessions";

interface Props {
  blok: {
    name?: string;
    role?: string;
    photo?: string | { filename?: string; alt?: string };
    email?: string;
    phone?: string;
    booking_label?: string;
    booking_link?: any;
    /** Personal website (multilink, optional). */
    website?: any;
    availability?: string;
    bio?: any;
    prestations?: any;
    tarifs?: any;
  };
  tags?: string[];
  /** Public URL of this page (e.g. "/equipe/laura-gleizes"). */
  pageUrl?: string;
  /** UUID of the `person` story: used to find her upcoming sessions. */
  personUuid?: string;
}

const { blok, tags = [], pageUrl = "", personUuid = "" } = Astro.props;
const origin = siteOrigin(Astro.url, Astro.site);
const site = siteInfoFromGlobal(
  origin,
  (await getGlobalStory())?.content,
  "La Parent'elle",
);
const personNode =
  blok.name != null && String(blok.name).trim()
    ? personSchema(site, {
        name: String(blok.name).trim(),
        url: pageUrl || undefined,
        jobTitle:
          typeof blok.role === "string" && blok.role.trim()
            ? blok.role.trim()
            : undefined,
        image: imgSrc(blok.photo)
          ? absoluteUrl(origin, imgSrc(blok.photo))
          : undefined,
        email:
          typeof blok.email === "string" && blok.email.trim()
            ? blok.email.trim()
            : undefined,
        phone:
          typeof blok.phone === "string" && blok.phone.trim()
            ? blok.phone.trim()
            : undefined,
        knowsAbout: tags.length > 0 ? tags : undefined,
      })
    : null;
const bio = blok.bio ? renderRichText(blok.bio) : "";
const prestations = blok.prestations ? renderRichText(blok.prestations) : "";
const tarifs = blok.tarifs ? renderRichText(blok.tarifs) : "";
const src = imgSrc(blok.photo);
const bookingHref =
  blok.booking_link?.cached_url || blok.booking_link?.url
    ? resolveLink(blok.booking_link)
    : null;
// Personal website: same multilink shape as the booking link, optional.
const websiteHref =
  blok.website?.cached_url || blok.website?.url
    ? resolveLink(blok.website)
    : null;

// Lightweight planning: her next sessions (nothing rendered when empty).
const upcoming = await fetchSessionsByPerson(personUuid);
const upcomingSlots = upcoming.slice(0, 4).flatMap((s) => {
  const day = sessionDayKey(s.start);
  if (!day || !s.start) return [];
  const timing = sessionTiming(s.start, s.duration ?? 60);
  return [{ title: s.title, timing, day }];
});
---

<article class="person" {...storyblokEditable(blok)}>
  <header class="person-head">
    {src && (
      <figure class="person-photo frame-organic">
        <SbImage
          src={src}
          alt={imgAlt(blok.photo, blok.name)}
          widths={[480, 800]}
          sizes="(max-width: 700px) 100vw, 480px"
          loading="eager"
        />
      </figure>
    )}
    <div>
      {blok.name && <h1 class="person-name">{blok.name}</h1>}
      {blok.role && <p class="person-role">{blok.role}</p>}
      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) => <li class="badge">{t}</li>)}
        </ul>
      )}
    </div>
  </header>

  {upcomingSlots.length > 0 && (
    <section class="person-block person-slots">
      <h2>Mes prochains créneaux</h2>
      <ul class="slot-list">
        {upcomingSlots.map((s) => (
          <li class="slot-row">
            <div>
              <strong>{s.timing.date}</strong>
              {s.timing.range && <span> · {s.timing.range}</span>}
              <span class="slot-title"> — {s.title}</span>
            </div>
            <a class="slot-link" href={`/programme-du-mois?date=${s.day}`}>Réserver</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {bio && (
    <section class="person-block">
      <h2>Présentation</h2>
      <div class="richtext" set:html={bio} />
    </section>
  )}

  {prestations && (
    <section class="person-block">
      <h2>Prestations</h2>
      <div class="richtext" set:html={prestations} />
    </section>
  )}

  {tarifs && (
    <section class="person-block">
      <h2>Tarifs</h2>
      <div class="richtext" set:html={tarifs} />
    </section>
  )}

  <aside class="person-contact">
    <h2>Mes coordonnées</h2>
    {blok.availability && <p class="muted">{blok.availability}</p>}
    <div class="btn-row">
      {websiteHref && (
        <Button href={websiteHref}>Site web</Button>
      )}
      {blok.booking_label && bookingHref && (
        <Button href={bookingHref}>{blok.booking_label}</Button>
      )}
      {blok.phone && (
        <Button variant="ghost" href={`tel:${blok.phone.replace(/[\s.]/g, "")}`}>
          {blok.phone}
        </Button>
      )}
      {blok.email && (
        <Button variant="ghost" href={`mailto:${blok.email}`}>
          {blok.email}
        </Button>
      )}
    </div>
  </aside>

  <section class="person-block">
    <h2>M'écrire un message</h2>
    {blok.email ? (
      <ContactForm fixedName={blok.name} fixedEmail={blok.email} />
    ) : (
      <ContactForm fixedName="l'administratif" fixedEmail={adminEmail()} forName={blok.name} />
    )}
  </section>

  <p class="back">
    <a href="/equipe">← Toute l'équipe</a>
  </p>
  {personNode && (
    <script
      type="application/ld+json"
      set:html={jsonLd({ "@context": "https://schema.org", ...personNode })}
    />
  )}
</article>

<style>
  .person {
    padding-block: 3rem 4rem;
    display: grid;
    gap: 2.5rem;
  }

  .person-head {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  @media (min-width: 48rem) {
    .person-head {
      grid-template-columns: 16rem 1fr;
      gap: 2.5rem;
    }
  }

  .person-photo {
    margin: 0;
  }

  .person-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }

  .person-name {
    margin: 0 0 0.25rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
  }

  .person-role {
    margin: 0 0 1rem;
    color: var(--c-pine-soft);
    font-size: 1.1rem;
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .person-block h2 {
    font-size: 1.4rem;
    margin: 0 0 0.75rem;
  }

  .slot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    max-width: 46rem;
  }

  .slot-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    border: 1px solid var(--c-line);
    border-radius: 0.75rem;
    background: #fff;
  }

  .slot-link {
    color: var(--c-pine);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .slot-link:hover {
    text-decoration: underline;
  }

  .person-block .richtext {
    color: var(--muted);
    max-width: 46rem;
  }

  .person-contact {
    border: 0;
    border-radius: var(--radius-card);
    background: var(--neu-surface);
    box-shadow: var(--shadow-neu);
    padding: 1.75rem;
  }

  .person-contact h2 {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
  }

  .muted {
    color: var(--muted);
  }

  .back a {
    color: var(--c-pine);
    text-decoration: none;
  }
</style>
