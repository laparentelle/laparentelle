# Copy to `.env` and fill in values (never commit `.env`)
# IS_PREVIEW=false -> static SSG + published stories (production)
# IS_PREVIEW=true  -> SSR + draft stories (Storyblok visual preview)
IS_PREVIEW=false
# Canonical origin for absolute SEO URLs (canonical, og:url, sitemap).
# Fill in the real production domain, e.g. https://laparentelle.fr
# (also set it on Vercel — Astro inlines it at build time).
PUBLIC_SITE_URL=
STORYBLOK_TOKEN=placeholder-token
STORYBLOK_SPACE_ID=
STORYBLOK_PERSONAL_TOKEN=
# Bookings (optional): see supabase/migrations/001_bookings.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="La Parent'elle <contact@example.com>"
